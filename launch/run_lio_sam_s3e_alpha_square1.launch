<launch>

    <arg name="project" default="liorf"/>
    <arg name="use_cbs_optimizer" default="false"/>
    <arg name="loop_closure" default="false"/>
    <arg name="use_imu_heading_init" default="false"/>
    <arg name="imu_use_ext_rot_inverse" default="false"/>
    <arg name="external_exchange_in_body_frame" default="true"/>
    <arg name="external_exchange_use_ext_rot_inverse" default="false"/>
    <arg name="cbs_diag_force_identity_exchange_to_lidar" default="false"/>
    <arg name="cbs_outgoing_cov_scale" default="1.0"/>
    <arg name="lidar_min_range" default="1.0"/>
    <arg name="downsample_rate" default="1"/>
    <arg name="point_filter_num" default="1"/>
    <arg name="surrounding_keyframe_search_radius" default="50.0"/>

    <arg name="input_points_topic" default="/Alpha/velodyne_points"/>
    <arg name="dense_points_topic" default="/Alpha/velodyne_points_dense"/>

    <!-- S3E Alpha tuned LIORF parameters -->
    <rosparam file="$(find liorf)/config/lio_sam_s3e_alpha_square1.yaml" command="load" />

    <!-- Runtime toggles for reproducible A/B runs -->
    <param name="/liorf/use_cbs_optimizer" value="$(arg use_cbs_optimizer)" />
    <param name="/liorf/loopClosureEnableFlag" value="$(arg loop_closure)" />
    <param name="/liorf/useImuHeadingInitialization" value="$(arg use_imu_heading_init)" />
    <param name="/liorf/imuUseExtRotInverse" value="$(arg imu_use_ext_rot_inverse)" />
    <param name="/liorf/external_exchange_in_body_frame" value="$(arg external_exchange_in_body_frame)" />
    <param name="/liorf/external_exchange_use_ext_rot_inverse" value="$(arg external_exchange_use_ext_rot_inverse)" />
    <param name="/liorf/cbs_diag_force_identity_exchange_to_lidar" value="$(arg cbs_diag_force_identity_exchange_to_lidar)" />
    <param name="/liorf/cbs_outgoing_cov_scale" value="$(arg cbs_outgoing_cov_scale)" />
    <param name="/liorf/lidarMinRange" value="$(arg lidar_min_range)" />
    <param name="/liorf/downsampleRate" value="$(arg downsample_rate)" />
    <param name="/liorf/point_filter_num" value="$(arg point_filter_num)" />
    <param name="/liorf/surroundingKeyframeSearchRadius" value="$(arg surrounding_keyframe_search_radius)" />
    <param name="/liorf/pointCloudTopic" value="$(arg dense_points_topic)" />

    <!-- S3E ROS1 cloud stream carries NaNs and is_dense=false. Bridge removes NaNs and republishes dense cloud. -->
    <node pkg="$(arg project)" type="pointcloud_dense_bridge.py" name="$(arg project)_pointcloud_dense_bridge"
          output="screen" respawn="true">
        <param name="input_topic" value="$(arg input_points_topic)" />
        <param name="output_topic" value="$(arg dense_points_topic)" />
    </node>

    <!-- LOAM -->
    <include file="$(find liorf)/launch/include/module_loam.launch" />

</launch>
